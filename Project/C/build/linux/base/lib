LEVEL=$1
PRODUCT=${PWD##*/}
HOMEPATH=$(cd `dirname $0`; pwd)/../../../
if [ "$LEVEL" == "" ]; then
   LEVEL="alpha"
fi
OWNER=${USER}
CONTAINER="gcc9"
File=$(basename $0)

chmod a+x ../ENV
../ENV ${PRODUCT} ${LEVEL} ${CONTAINER}

echo -e "Now enter container \033[36m${CONTAINER}\033[0m and build \033[36m${PRODUCT}\033[0m lib"
docker exec -it ${CONTAINER} bash -c "cd /project/DAVE/Project/C/build/linux/${PRODUCT} && chmod +x __lib__ && ./__lib__ ${LEVEL}"

if [ "$OWNER" != "" ]; then
   echo ${File} chown ${HOMEPATH}../../ to ${OWNER}
   sudo chown -R ${OWNER}:${OWNER} ${HOMEPATH}../../
fi