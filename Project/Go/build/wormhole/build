PRODUCT=${PWD##*/}
CONTAINER="golang21"

../ENV ${CONTAINER}

echo -e "Now enter container \033[36m${CONTAINER}\033[0m and build \033[36m${PRODUCT}\033[0m project"
docker exec -it ${CONTAINER} bash -c "cd /project/DAVE/Project/Go/project/product/${PRODUCT} && chmod a+x BUILD && ./BUILD"