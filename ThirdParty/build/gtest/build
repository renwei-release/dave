PROJECT=${PWD##*/}
CONTAINER=$1

if [ "$CONTAINER" == "" ]; then
   CONTAINER="fedora30"-${USER}
fi

if [ "$CONTAINER" == "" ]; then
   CONTAINER="fedora30"-${USER}
fi

../ENV ${CONTAINER}

if [ ! "$CONTAINER" == "" ]; then
   echo -e "Now enter container \033[36m${CONTAINER}\033[0m and build \033[36m${PROJECT}\033[0m project"
   docker exec -it ${CONTAINER} bash -c "cd /project/DAVE/ThirdParty/build/${PROJECT} && ./__build__"
else
   ./__build__
fi